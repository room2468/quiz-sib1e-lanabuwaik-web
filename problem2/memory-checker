read -r total_mb
read -r used_mb

free_mb=$(( total_mb - used_mb ))
usage=$(( used_mb * 100 / total_mb ))

if (( usage >= 90 )); then
    status="Critical"
elif (( usage >= 70 )); then
    status="Warning"
else
    status="Normal"
fi

echo "Free: $free_mb MB"
echo "Usage: $usage%"
echo "Status: $status"
